# Telegram bot tokeni — @BotFather dan olinadi
TELEGRAM_BOT_TOKEN=

# PostgreSQL (Supabase) ulanish satrlari
DATABASE_URL=

# eMaktab parollarini bazada shifrlash kaliti (istalgan uzunlikdagi maxfiy satr).
# MUHIM: bu qiymatni hech qachon o'zgartirmang — o'zgarsa, saqlangan parollar ochilmaydi!
ENCRYPTION_KEY=

# Ilovaning ommaviy URL manzili (one-click eMaktab kirish sahifasi uchun)
APP_URL=

# Webhook himoyasi uchun maxfiy satr (set-webhook orqali ham ishlatiladi)
TELEGRAM_WEBHOOK_SECRET=
